---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import PostCard from '../../components/PostCard.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts } from '../../consts';

const posts = await getPosts();
const [latest] = posts;
---
<BaseLayout title="개발 블로그 · Casebook" description="Casebook을 만들며 남기는 개발일지, 작업 기록, 릴리스 노트" current="blog" alt>
  <main class="wrap page">
    <h1>개발 블로그</h1>
    {latest ? (
      <>
        <CategoryFilter target="#posts" />
        <div class="latest" id="latest">
          <PostCard post={latest} feature label={`${latest.data.category} · 최신`} />
        </div>
        <section aria-labelledby="list-title">
          <h2 id="list-title">모든 글</h2>
          <ul class="tile list" id="posts">
            {posts.map((post) => <PostRow post={post} />)}
          </ul>
          <p class="empty" hidden>이 분류에는 아직 글이 없어요.</p>
        </section>
      </>
    ) : (
      <p>아직 글이 없어요.</p>
    )}
  </main>
</BaseLayout>

<script>
  // 분류를 고르면 최신 글 타일을 숨기고, 걸러진 글이 없으면 안내를 보여 준다.
  document.addEventListener('filter', (event) => {
    const category = (event as CustomEvent<string>).detail;
    const latest = document.getElementById('latest');
    if (latest) latest.hidden = !!category;
    const visible = document.querySelectorAll('#posts > li:not([hidden])').length;
    const list = document.getElementById('posts');
    const empty = document.querySelector<HTMLElement>('.empty');
    if (list) list.hidden = visible === 0;
    if (empty) empty.hidden = visible > 0;
  });
</script>

<style>
  .page { padding-top: 56px; padding-bottom: 100px; display: flex; flex-direction: column; gap: 40px; }
  h1 { margin: 0; font-size: 48px; line-height: 1.08; }
  section { display: flex; flex-direction: column; gap: 16px; }
  h2 { margin: 0; font-size: 28px; }
  .list { list-style: none; margin: 0; padding: 0; overflow: hidden; }
  .list[hidden], .latest[hidden] { display: none; }
  .empty { margin: 0; color: var(--muted); }

  @media (max-width: 734px) {
    .page { padding-top: 40px; gap: 28px; }
    h1 { font-size: 34px; }
  }
</style>
