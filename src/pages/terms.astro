import LegalLayout from '../layouts/LegalLayout.astro';
import { url } from '../consts';

const toc = [
  { id: 't1', text: '제1조 목적' },
  { id: 't2', text: '제2조 금지하는 콘텐츠와 행동' },
  { id: 't3', text: '제3조 신고와 차단' },
  { id: 't4', text: '제4조 운영자의 조치' },
  { id: 't5', text: '제5조 올린 사건의 권리와 책임' },
  { id: 't6', text: '제6조 리뷰' },
